<Window x:Class="Presentation.ShortestPathFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortest Path Finder - Dijkstra" Height="500" Width="500"
        WindowStartupLocation="CenterScreen" Background="#121212">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SHORTEST PATH FINDER" FontSize="22" FontWeight="Bold"
                   Foreground="#00FFCC" HorizontalAlignment="Center" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" Text="Algoritmo de Dijkstra" FontSize="13" Foreground="Gray"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Border Grid.Row="2" BorderBrush="#333" BorderThickness="1" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Origen:" Foreground="#00FFCC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtStartCity" Height="30" FontSize="14"
                         Background="#0D0D0D" Foreground="White" BorderBrush="#00FFCC" BorderThickness="1"
                         Padding="5,0" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Destino:" Foreground="#FF0055" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtEndCity" Height="30" FontSize="14"
                         Background="#0D0D0D" Foreground="White" BorderBrush="#FF0055" BorderThickness="1"
                         Padding="5,0" Margin="0,0,0,10"/>

                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="btnFindPath" Content="ENCONTRAR RUTA"
                        Height="35" Background="#00FFCC" Foreground="Black" FontWeight="Bold"
                        Click="BtnFindPath_Click" BorderThickness="0" Cursor="Hand" FontSize="14"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#333" BorderThickness="1" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="RUTA ENCONTRADA" FontSize="14" FontWeight="Bold" Foreground="#00FFCC" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtRoute" FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="txtDistance" FontSize="14" Foreground="#FF0055" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" BorderBrush="#333" BorderThickness="1" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                <ItemsControl x:Name="routeStepsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13" Foreground="#CCCCCC" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="5" x:Name="txtError" Foreground="#FF0055" FontSize="14"
                   TextWrapping="Wrap" VerticalAlignment="Top"/>

        <Button Grid.Row="6" x:Name="BtnVolver" Content="Volver al Menú"
                Height="35" Background="#FF3333" Foreground="White" FontWeight="Bold"
                Click="BtnVolver_Click" Margin="0,10,0,0"/>
    </Grid>
</Window>
