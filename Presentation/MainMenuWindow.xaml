<Window x:Class="Presentation.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patrones de Búsqueda - FISEI" Height="450" Width="350" WindowStartupLocation="CenterScreen" Background="#0D0D0D">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
        <TextBlock Text="MENÚ PRINCIPAL" FontSize="24" FontWeight="Bold" Foreground="#00FFCC" HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <Button Content="1. N Reinas (Jumbo)" Margin="0,5" Height="35" Background="#1A1A1A" Foreground="White"/>
        <Button Content="2. Caballo Ajedrez " Margin="0,5" Height="35" Background="#1A1A1A" Foreground="White" Click="Button_Click"/>
        <Button Content="3. Laberinto " Margin="0,5" Height="35" Background="#1A1A1A" Foreground="White"/>
        <Button Content="4. Agente Viajero " Margin="0,5" Height="35" Background="#1A1A1A" Foreground="White"/>

        <Button Content="5. Tic-Tac-Toe (Cristian)" Margin="0,20,0,5" Height="40" Background="#FF0055" Foreground="White" FontWeight="Bold" Click="BtnTicTacToe_Click"/>
    </StackPanel>
</Window>