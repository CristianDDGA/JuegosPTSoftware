<Window x:Class="Presentation.MissionariesCannibalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Misioneros y Caníbales" Height="620" Width="720"
        WindowStartupLocation="CenterScreen" Background="#07090D">

    <Window.Resources>
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#9B8CFF"/>
            <Setter Property="Foreground" Value="#0B0818"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#FF2D55"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F0A1A" Offset="0"/>
                <GradientStop Color="#0D0D0D" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="MISIONEROS Y CANÍBALES" FontSize="26" FontWeight="Black" Foreground="#9B8CFF" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#9B8CFF" BlurRadius="18" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Cruce seguro del río con búsqueda en anchura (BFS)" FontSize="14" Foreground="#A7B3C0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="Barca: máx. 2 personas · Caníbales no pueden superar a misioneros" FontSize="12" Foreground="#6B7A8F" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Button x:Name="BtnSolve" Content="Resolver con BFS" Width="160" Margin="6" Style="{StaticResource PrimaryActionButton}" Click="BtnSolve_Click"/>
            <Button x:Name="BtnReset" Content="Reiniciar" Width="140" Margin="6" Style="{StaticResource SecondaryActionButton}" Click="BtnReset_Click"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#2A2540" BorderThickness="1" Background="#11161D" CornerRadius="16" Padding="18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#0D131A" CornerRadius="12" Padding="14" Margin="0,0,0,14" BorderBrush="#3D3558" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Resumen" FontSize="16" FontWeight="Bold" Foreground="#9B8CFF"/>
                            <TextBlock x:Name="TxtSummary" Text="Presiona Resolver para calcular la secuencia óptima de cruces." FontSize="14" Foreground="#DCE7F5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="StepsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" CornerRadius="12" Background="#0D131A" BorderBrush="#3D3558" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Border Width="92" Height="28" CornerRadius="14" Background="#9B8CFF" DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding BadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0B0818" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding ActionText}" Foreground="#A7B3C0" FontSize="13" FontStyle="Italic" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Margin="0,0,8,0" Background="#141024" CornerRadius="10" Padding="12" BorderBrush="#3D3558" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Orilla izquierda" Foreground="#C4B5FD" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="{Binding LeftSideText}" Foreground="#EEF5FF" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Margin="8,0,0,0" Background="#141024" CornerRadius="10" Padding="12" BorderBrush="#3D3558" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Orilla derecha" Foreground="#C4B5FD" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="{Binding RightSideText}" Foreground="#EEF5FF" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3" Content="Volver al Menú" Height="40" Margin="0,16,0,0" Style="{StaticResource DangerActionButton}" Click="BtnBack_Click"/>
    </Grid>
</Window>
