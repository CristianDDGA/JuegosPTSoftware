<Window x:Class="Presentation.TicTacToeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tres en Raya - Cyberpunk Edition" Height="612" Width="566" WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Window.Resources>
        <Style x:Key="NeonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="55"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#00FFCC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#262626"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#00FFCC" BlurRadius="15" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RestartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0055"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF0055" BlurRadius="20" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="534">

            <TextBlock Text="TRES EN RAYA" FontSize="30" FontWeight="Black" Foreground="#00FFCC" HorizontalAlignment="Center" Margin="0,0,0,5">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00FFCC" BlurRadius="20" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="TxtStatus" Text="Tu turno (X)" FontSize="18" FontWeight="Bold" Foreground="#FF0055" Margin="0,0,0,25" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF0055" BlurRadius="15" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <UniformGrid x:Name="GridBoard" Rows="3" Columns="3" Width="320" Height="320" Margin="0,0,0,30">
                <Button Click="Cell_Click" Tag="0,0" Style="{StaticResource NeonButtonStyle}"/>
                <Button Click="Cell_Click" Tag="0,1" Style="{StaticResource NeonButtonStyle}"/>
                <Button Click="Cell_Click" Tag="0,2" Style="{StaticResource NeonButtonStyle}"/>
                <Button Click="Cell_Click" Tag="1,0" Style="{StaticResource NeonButtonStyle}"/>
                <Button Click="Cell_Click" Tag="1,1" Style="{StaticResource NeonButtonStyle}"/>
                <Button Click="Cell_Click" Tag="1,2" Style="{StaticResource NeonButtonStyle}"/>
                <Button Click="Cell_Click" Tag="2,0" Style="{StaticResource NeonButtonStyle}"/>
                <Button Click="Cell_Click" Tag="2,1" Style="{StaticResource NeonButtonStyle}"/>
                <Button Click="Cell_Click" Tag="2,2" Style="{StaticResource NeonButtonStyle}"/>
            </UniformGrid>

            <Button Content="REINICIAR SISTEMA" Width="200" Height="40" Click="BtnRestart_Click" Style="{StaticResource RestartButtonStyle}"/>
            <Button Content="VOLVER AL MENÚ" Width="200" Height="30" Margin="0,10,0,0"
                    Click="BtnVolver_Click" Background="Transparent" 
                    Foreground="White" BorderBrush="White" BorderThickness="1" 
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>