<Window x:Class="Presentation.JarraAguaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarra de Agua" Height="650" Width="600" WindowStartupLocation="CenterScreen" Background="#181824">
    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00AAFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinkButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#FF0055"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Grid.RowSpan="6" Margin="18" CornerRadius="18" Background="#232336"/>
        <Grid Margin="28,18,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="JARRA DE AGUA" FontSize="28" FontWeight="Bold" Foreground="#00AAFF" HorizontalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="Resuelve el clásico problema de las jarras usando búsqueda en anchura (BFS)." FontSize="15" Foreground="#B0B8D1" HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <Border Grid.Row="2" Background="#181824" CornerRadius="12" Padding="10" Margin="0,0,0,10" BorderBrush="#00AAFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Resumen" FontWeight="Bold" Foreground="#00AAFF" FontSize="16"/>
                    <TextBlock Text="Tienes dos jarras: A (4L) y B (3L). El objetivo es obtener exactamente 2 litros en alguna de las jarras. Puedes llenar, vaciar o transferir agua entre ellas. Usa los botones para simular los movimientos o resuelve automáticamente con BFS." TextWrapping="Wrap" Foreground="#B0B8D1" Margin="0,4,0,0" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#232336" CornerRadius="10" Padding="6" Margin="0,0,0,10" BorderBrush="#00AAFF" BorderThickness="1">
                <ScrollViewer x:Name="SolucionScroll" VerticalScrollBarVisibility="Auto" Height="180" Background="#232336" BorderThickness="0">
                    <StackPanel x:Name="SolucionPanel" />
                </ScrollViewer>
            </Border>

            <UniformGrid Grid.Row="4" Rows="2" Columns="3" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Llenar A" Style="{StaticResource RoundedButtonStyle}" FontSize="15" MinWidth="120" MinHeight="38" Click="BtnLlenarA_Click"/>
                <Button Content="Llenar B" Style="{StaticResource RoundedButtonStyle}" FontSize="15" MinWidth="120" MinHeight="38" Click="BtnLlenarB_Click"/>
                <Button Content="Vaciar A" Style="{StaticResource RoundedButtonStyle}" FontSize="15" MinWidth="120" MinHeight="38" Click="BtnVaciarA_Click"/>
                <Button Content="Vaciar B" Style="{StaticResource RoundedButtonStyle}" FontSize="15" MinWidth="120" MinHeight="38" Click="BtnVaciarB_Click"/>
                <Button Content="Transferir A → B" Style="{StaticResource RoundedButtonStyle}" FontSize="15" MinWidth="150" MinHeight="38" Click="BtnTransferirAB_Click"/>
                <Button Content="Transferir B → A" Style="{StaticResource RoundedButtonStyle}" FontSize="15" MinWidth="150" MinHeight="38" Click="BtnTransferirBA_Click"/>
            </UniformGrid>

            <UniformGrid Grid.Row="5" Rows="1" Columns="3" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Resolver BFS" MinWidth="160" Height="44" Margin="8" FontSize="16" Style="{StaticResource PinkButtonStyle}" Click="BtnResolver_Click"/>
                <Button Content="Jugar de Nuevo" MinWidth="160" Height="44" Margin="8" FontSize="16" Style="{StaticResource PinkButtonStyle}" Click="BtnReiniciar_Click"/>
                <Button Content="Menú" MinWidth="160" Height="44" Margin="8" FontSize="16" Style="{StaticResource PinkButtonStyle}" Click="BtnMenu_Click"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
