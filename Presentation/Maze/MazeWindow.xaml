<Window x:Class="Presentation.Maze.MazeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laberinto" Height="550" Width="450" WindowStartupLocation="CenterScreen" Background="#0D0D0D"
        KeyDown="Window_KeyDown" Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Laberinto BFS" FontSize="20" FontWeight="Bold" Foreground="#00FFCC" HorizontalAlignment="Center" Margin="10"/>

        <Grid x:Name="GridMaze" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Height="380" Grid.Row="1">
            <!-- Filas y Columnas se generarán dinámicamente desde el código xaml.cs -->
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2" Margin="10">
            <Button Content="Nuevo" Width="80" Height="30" Margin="5" Background="#00AAFF" Foreground="White" Click="BtnNew_Click"/>
            <Button Content="Resolver BFS" Width="100" Height="30" Margin="5" Background="#1A1A1A" Foreground="White" Click="BtnSolve_Click"/>
            <Button Content="Menú" Width="80" Height="30" Margin="5" Background="#FF0055" Foreground="White" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>
